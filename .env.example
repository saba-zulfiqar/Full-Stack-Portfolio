# Database connection (PostgreSQL - Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# NextAuth configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"
AUTH_SECRET="your-auth-secret-here"

# Default Admin credentials (used during database seeding)
ADMIN_EMAIL="your-admin@example.com"
ADMIN_PASSWORD="your-admin-password-here"

# Email notification (Resend - optional, fallback simulated if not provided)
RESEND_API_KEY="your-resend-api-key-here"
CONTACT_NOTIFICATION_EMAIL="your-email@example.com"

# Cloudinary image upload (optional, local/URL fallback available)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
